{{- $file := printf "%s/%s/%s/release.yaml" (requiredEnv "BOOTSTRAP_RENDER_DIR") .Release.Namespace .Release.Name -}}
{{- $base := printf "../../kubernetes/apps/base/%s/%s/app/ocirepository.yaml" .Release.Namespace .Release.Name -}}
{{- if isFile $file -}}
{{ readFile $file }}
{{- else if isFile $base -}}
{{- /* Not selected but installed anyway (CRDs only): the app's base chart */ -}}
{{- with readFile $base | fromYaml }}
chart: {{ .spec.url }}
version: {{ .spec.ref.tag }}
{{- end -}}
{{- else -}}
chart: unselected/{{ .Release.Name }}
version: ""
{{- end -}}
