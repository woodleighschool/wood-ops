---
machine:
  # ca merges as a unit; crt must be repeated alongside key
  ca:
    crt: op://KubernetesSC/talos/MACHINE_CA_CRT
    key: op://KubernetesSC/talos/MACHINE_CA_KEY
cluster:
  # ca merges as a unit; crt must be repeated alongside key
  ca:
    crt: op://KubernetesSC/talos/CLUSTER_CA_CRT
    key: op://KubernetesSC/talos/CLUSTER_CA_KEY
  aggregatorCA:
    crt: op://KubernetesSC/talos/CLUSTER_AGGREGATORCA_CRT
    key: op://KubernetesSC/talos/CLUSTER_AGGREGATORCA_KEY
  etcd:
    advertisedSubnets:
      - 10.10.69.0/24
    ca:
      crt: op://KubernetesSC/talos/CLUSTER_ETCD_CA_CRT
      key: op://KubernetesSC/talos/CLUSTER_ETCD_CA_KEY
  serviceAccount:
    key: op://KubernetesSC/talos/CLUSTER_SERVICEACCOUNT_KEY
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
certExtraSANs:
  - 10.10.69.100
  - k8s.woodleighschool.net
---
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - providers:
        - secretbox:
            keys:
              - name: key2
                secret: op://KubernetesSC/talos/CLUSTER_SECRETBOXENCRYPTIONSECRET
        - identity: {}
      resources:
        - secrets
